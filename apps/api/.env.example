# Local development defaults. In Railway set these as service variables.
DATABASE_URL=sqlite:///./personal_os.db
JWT_SECRET=change-me-to-a-long-random-string-of-32+-chars
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
DEFAULT_TIMEZONE=America/Sao_Paulo
ENVIRONMENT=development
# Public URL of the API service (used in OAuth metadata for the Claude connector), e.g. https://personal-os-api.up.railway.app
# Optional: browser origins allowed to call the API directly, e.g. https://seu-app.vercel.app
CORS_ORIGINS=
PUBLIC_URL=
